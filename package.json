    "test:all": "npm test && npm run test:e2e",
    "smoke": "node scripts/live-smoke.js",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "private": true,
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^45.4.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
