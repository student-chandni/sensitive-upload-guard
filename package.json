{
  "name": "sensitive-upload-guard",
  "version": "1.0.0",
  "description": "Desktop DLP guard for ChatGPT and Perplexity web: inspects prompts and file uploads for WALLED_SENSITIVE and asks for native confirmation.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/ensure-electron.js",
